[Unit]
Description=GlassCAD — проектирование душевых и изделий из стекла
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=GLASSCAD_DATA=@DATA_DIR@
Environment=GLASSCAD_PORT=@PORT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port @PORT@ --workers 1
Restart=on-failure
RestartSec=3
# защита: код только для чтения, писать можно лишь в папку данных
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
